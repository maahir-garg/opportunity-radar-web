# Copy to .env.local for local development. See the "Sign-up storage" section
# of README.md for the full explanation. Nothing here is required to run the
# site: without any of it, /api/waitlist simply does not persist sign-ups.

# --- Option 1: get an email when someone signs up (Resend) -----------------
# Recommended if you just want to know when a sign-up comes in. Sign up free
# at resend.com, copy the API key from the dashboard, and set both of these:
#   RESEND_API_KEY        the key from the Resend dashboard
#   WAITLIST_NOTIFY_EMAIL the address you want notifications sent to
# Without a verified sending domain, Resend only lets you send FROM
# onboarding@resend.dev and only deliver TO the email address your Resend
# account was created with -- fine for "notify me", not for sending to
# someone else. If you later verify your own domain in Resend, set
# WAITLIST_FROM_EMAIL to send from your own address instead.
RESEND_API_KEY=
WAITLIST_NOTIFY_EMAIL=
WAITLIST_FROM_EMAIL=

# --- Option 2: Upstash Redis / Vercel KV -----------------------------------
# For a structured, queryable list of sign-ups rather than an inbox full of
# emails. In the Vercel dashboard: Storage -> Create Database -> add the
# Upstash-backed KV integration to this project, and it injects both of these
# automatically (no copy-pasting secrets). For local development, pull them
# with `vercel env pull .env.local`, or paste the values from the Upstash
# console's REST API tab. Takes priority over Option 1 if both are set.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Option 3: generic webhook ----------------------------------------------
# Alternative to the above. Every accepted submission is POSTed as JSON to
# this URL. Point it at Zapier, Make, n8n, a Discord/Slack incoming webhook,
# or your own endpoint. Only used when neither option above is configured.
WAITLIST_WEBHOOK_URL=

# --- Optional, unrelated to storage -----------------------------------------
# Used for canonical URLs, the sitemap and the Open Graph image.
NEXT_PUBLIC_SITE_URL=
